{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "PowerShell(git *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(node *)",
      "PowerShell(Set-Location *)",
      "PowerShell(Get-* *)",
      "PowerShell(Start-* *)",
      "PowerShell(Stop-* *)",
      "PowerShell(Add-Type *)",
      "PowerShell(Copy-Item *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push:*)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git push:*)",
      "WebFetch",
      "WebSearch",
      "Bash(curl)",
      "Bash(curl *)",
      "Bash(curl:*)",
      "Bash(wget)",
      "Bash(wget *)",
      "Bash(wget:*)",
      "Bash(http *)",
      "Bash(https *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(Invoke-WebRequest)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Start-BitsTransfer *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)"
    ]
  }
}
